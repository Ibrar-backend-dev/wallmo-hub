# Every knob the service has. Copy to .env and edit; nothing is hard-coded.
# Defaults shown here match app/config.py.

# ---- runtime ----
ENV=local                       # local | staging | production
LOG_LEVEL=INFO
LOG_JSON=false                  # true in production so log shippers can parse
DEBUG=false
DOCS_ENABLED=true               # false in production to hide /docs and /openapi.json

# ---- database ----
# docker compose publishes Postgres on 5433 (see DB_PORT in docker-compose.yml)
DATABASE_URL=postgresql://wallmo:wallmo@localhost:5433/wallmo
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_COMMAND_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=8000
DB_STATEMENT_CACHE_SIZE=256     # MUST be 0 behind pgbouncer transaction pooling
DB_MAX_INACTIVE_LIFETIME=300

# ---- media delivery ----
# Public CDN/origin prefix. file_path = MEDIA_BASE_URL + "/" + storage_key
MEDIA_BASE_URL=http://localhost:8000/media

# ---- pagination ----
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=200
BUNDLE_LIMIT_DEFAULT=500        # media per subcategory in /bundle
BUNDLE_LIMIT_MAX=2000

# ---- caching ----
CACHE_ENABLED=true
CACHE_TTL_SECONDS=30            # in-process response cache
CACHE_MAX_ENTRIES=512
HTTP_MAX_AGE=60                 # Cache-Control max-age sent to the CDN/client
HTTP_STALE_WHILE_REVALIDATE=300
GZIP_MIN_SIZE=1024

# ---- rate limiting (per worker; the edge is the real limiter) ----
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=120

# ---- CORS ----
CORS_ORIGINS=*                  # comma-separated list in production

# ---- storage: Backblaze B2 over its S3-compatible endpoint ----
STORAGE_BACKEND=none            # none | b2
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=
B2_UPLOAD_CONCURRENCY=4
STORAGE_ALLOW_PURGE=false       # allow DELETE ?purge=true to remove objects

# ---- uploads ----
UPLOAD_MAX_BYTES=67108864
UPLOAD_IMAGE_MIMES=image/png,image/jpeg,image/webp
UPLOAD_VIDEO_MIMES=video/mp4,video/webm
THUMB_WIDTH=400
PREVIEW_WIDTH=1080
WEBP_QUALITY=82
ENFORCE_KIND_MEDIA_MATCH=true   # static -> image, live -> video

# ---- write surface ----
# Read endpoints are public and unauthenticated by design. The admin router is
# not mounted at all unless ADMIN_ENABLED=true. ADMIN_API_KEY is an optional
# extra header check (X-API-Key) and is skipped entirely when blank.
ADMIN_ENABLED=false
ADMIN_API_KEY=

# ---- observability ----
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
